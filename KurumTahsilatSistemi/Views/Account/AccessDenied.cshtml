@{
    ViewData["Title"] = "Erişim Engellendi";
}

<div class="row justify-content-center">
    <div class="col-lg-7">

        <div class="card text-center p-4 p-md-5">

            <div class="access-denied-icon">
                !
            </div>

            <h2 class="mb-3">
                Bu işlem için yetkiniz bulunmuyor
            </h2>

            <p class="text-muted mb-4">
                Erişmeye çalıştığınız sayfa yalnızca yetkili kullanıcılar
                tarafından görüntülenebilir.
            </p>

            <div class="d-flex justify-content-center
                        flex-wrap gap-2">

                <a asp-controller="Home"
                   asp-action="Index"
                   class="btn btn-primary">
                    Ana Sayfaya Dön
                </a>

                <button type="button"
                        class="btn btn-secondary"
                        onclick="history.back()">
                    Önceki Sayfaya Dön
                </button>

            </div>

        </div>

    </div>
</div>

<style>
    .access-denied-icon {
        width: 72px;
        height: 72px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px;
        border-radius: 50%;
        background-color: #fff2d5;
        color: #936714;
        font-size: 31px;
        font-weight: 800;
    }
</style>