@model KurumTahsilatSistemi.Models.Musteri

@{
    ViewData["Title"] = "Müşteri Detayı";

    var musteriHarfi =
        string.IsNullOrWhiteSpace(Model.AdSoyad)
            ? "M"
            : Model.AdSoyad.Substring(0, 1).ToUpper();
}

<div class="row justify-content-center">
    <div class="col-lg-9">

        <div class="d-flex flex-column flex-md-row
                    justify-content-between align-items-md-center
                    gap-3 mb-4">

            <div>
                <h2 class="mb-2">Müşteri Detayı</h2>

                <p class="text-muted mb-0">
                    Müşteriye ait kayıtlı bilgiler görüntülenmektedir.
                </p>
            </div>

            <a asp-action="Index"
               class="btn btn-secondary">
                Müşteri Listesine Dön
            </a>
        </div>

        <div class="card musteri-detay-karti">

            <div class="musteri-detay-ust">

                <div class="musteri-baslik">

                    <div class="musteri-buyuk-avatar">
                        @musteriHarfi
                    </div>

                    <div>
                        <h3 class="mb-1">
                            @Model.AdSoyad
                        </h3>

                        <span class="musteri-no-etiketi">
                            @Model.MusteriNo
                        </span>
                    </div>

                </div>

                @if (Model.AktifMi)
                {
                    <span class="musteri-durum aktif">
                        Aktif Müşteri
                    </span>
                }
                else
                {
                    <span class="musteri-durum pasif">
                        Pasif Müşteri
                    </span>
                }

            </div>

            <div class="card-body">

                <div class="detay-bolum">

                    <div class="detay-bolum-baslik">
                        Temel Bilgiler
                    </div>

                    <div class="detay-grid">

                        <div class="detay-alani">
                            <span>Kayıt Numarası</span>
                            <strong>@Model.Id</strong>
                        </div>

                        <div class="detay-alani">
                            <span>Müşteri Numarası</span>
                            <strong>@Model.MusteriNo</strong>
                        </div>

                        <div class="detay-alani">
                            <span>Ad Soyad / Unvan</span>
                            <strong>@Model.AdSoyad</strong>
                        </div>

                        <div class="detay-alani">
                            <span>Oluşturulma Tarihi</span>

                            <strong>
                                @(Model.OlusturmaTarihi
                                                                .ToString("dd.MM.yyyy HH:mm"))
                            </strong>
                        </div>

                    </div>
                </div>

                <div class="detay-bolum">

                    <div class="detay-bolum-baslik">
                        Kimlik Bilgileri
                    </div>

                    <div class="detay-grid">

                        <div class="detay-alani">
                            <span>T.C. Kimlik Numarası</span>

                            <strong>
                                @(string.IsNullOrWhiteSpace(Model.Tckn)
                                                                ? "Tanımlanmamış"
                                                                : Model.Tckn)
                            </strong>
                        </div>

                        <div class="detay-alani">
                            <span>Vergi Numarası</span>

                            <strong>
                                @(string.IsNullOrWhiteSpace(Model.VergiNo)
                                                                ? "Tanımlanmamış"
                                                                : Model.VergiNo)
                            </strong>
                        </div>

                    </div>
                </div>

                <div class="detay-bolum">

                    <div class="detay-bolum-baslik">
                        İletişim Bilgileri
                    </div>

                    <div class="detay-grid">

                        <div class="detay-alani">
                            <span>E-posta</span>

                            <strong>
                                @(string.IsNullOrWhiteSpace(Model.Email)
                                                                ? "Tanımlanmamış"
                                                                : Model.Email)
                            </strong>
                        </div>

                        <div class="detay-alani">
                            <span>Telefon</span>

                            <strong>
                                @(string.IsNullOrWhiteSpace(Model.Telefon)
                                                                ? "Tanımlanmamış"
                                                                : Model.Telefon)
                            </strong>
                        </div>

                        <div class="detay-alani adres-alani">
                            <span>Adres</span>

                            <strong>
                                @(string.IsNullOrWhiteSpace(Model.Adres)
                                                                ? "Tanımlanmamış"
                                                                : Model.Adres)
                            </strong>
                        </div>

                    </div>
                </div>

                <div class="musteri-durum-aciklama">

                    <div class="durum-simgesi
                                @(Model.AktifMi ? "aktif" : "pasif")">

                        @(Model.AktifMi ? "✓" : "!")
                    </div>

                    <div>
                        <strong>
                            @(Model.AktifMi
                                                        ? "Müşteri kullanıma açık"
                                                        : "Müşteri kullanıma kapalı")
                        </strong>

                        <p class="mb-0">
                            @if (Model.AktifMi)
                            {
                                <span>
                                    Bu müşteri yeni işlemlerde kullanılabilir.
                                </span>
                            }
                            else
                            {
                                <span>
                                    Bu müşteri pasif durumdadır. Gerekirse
                                    düzenleme ekranından yeniden aktif
                                    hâle getirilebilir.
                                </span>
                            }
                        </p>
                    </div>

                </div>

                <div class="d-flex flex-wrap gap-2 mt-4">

                    <a asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="btn btn-primary">
                        Müşteriyi Düzenle
                    </a>

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        Listeye Dön
                    </a>

                </div>

            </div>
        </div>

    </div>
</div>

<style>
    .musteri-detay-karti {
        overflow: hidden;
    }

    .musteri-detay-ust {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 25px;
        padding: 26px 28px;
        background: linear-gradient(135deg, #0b294d, #123b6d);
        color: white;
    }

    .musteri-baslik {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .musteri-buyuk-avatar {
        width: 62px;
        height: 62px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 17px;
        background-color: white;
        color: #123b6d;
        font-size: 24px;
        font-weight: 800;
    }

    .musteri-detay-ust h3 {
        color: white;
    }

    .musteri-no-etiketi {
        display: inline-block;
        padding: 5px 9px;
        border-radius: 7px;
        background-color: rgba(255, 255, 255, 0.14);
        color: rgba(255, 255, 255, 0.88);
        font-size: 12px;
        font-weight: 600;
    }

    .musteri-durum {
        display: inline-flex;
        padding: 8px 13px;
        border-radius: 9px;
        font-size: 13px;
        font-weight: 700;
        white-space: nowrap;
    }

        .musteri-durum.aktif {
            background-color: #ddf5ed;
            color: #116653;
        }

        .musteri-durum.pasif {
            background-color: #edf0f4;
            color: #475467;
        }

    .detay-bolum {
        padding-bottom: 23px;
        margin-bottom: 23px;
        border-bottom: 1px solid #e6ebf2;
    }

    .detay-bolum-baslik {
        margin-bottom: 17px;
        color: #123b6d;
        font-size: 15px;
        font-weight: 750;
    }

    .detay-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
    }

    .detay-alani {
        padding: 15px 17px;
        border: 1px solid #e1e7ef;
        border-radius: 10px;
        background-color: #f8fafc;
    }

        .detay-alani span {
            display: block;
            margin-bottom: 5px;
            color: #667085;
            font-size: 12px;
        }

        .detay-alani strong {
            display: block;
            color: #1d2939;
            overflow-wrap: anywhere;
        }

    .adres-alani {
        grid-column: 1 / -1;
    }

    .musteri-durum-aciklama {
        display: flex;
        align-items: flex-start;
        gap: 13px;
        padding: 17px 18px;
        border: 1px solid #dce4ee;
        border-radius: 11px;
        background-color: #f8fafc;
    }

    .durum-simgesi {
        width: 38px;
        height: 38px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 50%;
        color: white;
        font-weight: 800;
    }

        .durum-simgesi.aktif {
            background-color: #15967d;
        }

        .durum-simgesi.pasif {
            background-color: #667085;
        }

    .musteri-durum-aciklama p {
        margin-top: 4px;
        color: #667085;
        font-size: 13px;
        line-height: 1.5;
    }

    @@media (max-width: 767px) {
        .musteri-detay-ust {
            align-items: flex-start;
            flex-direction: column;
        }

        .detay-grid {
            grid-template-columns: 1fr;
        }

        .adres-alani {
            grid-column: auto;
        }
    }
</style>