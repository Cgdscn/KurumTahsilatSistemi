@model KurumTahsilatSistemi.Models.TahsilatUrunu

@{
    ViewData["Title"] = "Tahsilat Ürünü Düzenle";

    var urunHarfi =
        string.IsNullOrWhiteSpace(Model.UrunAdi)
        ? "T"
        : Model.UrunAdi.Substring(0, 1).ToUpper();
}

<div class="row justify-content-center">
    <div class="col-lg-8">

        <div class="d-flex flex-column flex-md-row
                    justify-content-between align-items-md-center
                    gap-3 mb-4">

            <div>
                <h2 class="mb-2">Tahsilat Ürünü Düzenle</h2>

                <p class="text-muted mb-0">
                    Ürüne ait kod, ad ve bağlı kurum bilgilerini
                    güncelleyebilirsiniz.
                </p>
            </div>

            <div class="urun-id-etiketi">
                Kayıt No: @Model.Id
            </div>
        </div>

        <div class="card">

            <div class="card-header d-flex align-items-center gap-3">

                <div class="urun-duzenle-simgesi">
                    @urunHarfi
                </div>

                <div>
                    <div>Tahsilat Ürünü Bilgileri</div>

                    <small class="text-muted fw-normal">
                        @Model.UrunAdi
                    </small>
                </div>

            </div>

            <div class="card-body">

                <form asp-action="Edit" method="post">

                    <input type="hidden" asp-for="Id" />

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger">
                    </div>

                    <div class="row">

                        <div class="col-md-6 mb-3">
                            <label asp-for="UrunKodu"
                                   class="form-label">
                            </label>

                            <input asp-for="UrunKodu"
                                   class="form-control"
                                   placeholder="Örnek: OKUL001" />

                            <span asp-validation-for="UrunKodu"
                                  class="text-danger">
                            </span>

                            <div class="form-text">
                                Ürünü benzersiz olarak tanımlayan kısa koddur.
                            </div>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="UrunAdi"
                                   class="form-label">
                            </label>

                            <input asp-for="UrunAdi"
                                   class="form-control"
                                   placeholder="Örnek: Okul Taksidi" />

                            <span asp-validation-for="UrunAdi"
                                  class="text-danger">
                            </span>

                            <div class="form-text">
                                Kullanıcıların ekranlarda göreceği ürün adıdır.
                            </div>
                        </div>

                        <div class="col-12 mb-4">
                            <label asp-for="KurumId"
                                   class="form-label">
                            </label>

                            <select asp-for="KurumId"
                                    asp-items="ViewBag.KurumId"
                                    class="form-select">

                                <option value="0">
                                    Bağlı kurum seçiniz
                                </option>
                            </select>

                            <span asp-validation-for="KurumId"
                                  class="text-danger">
                            </span>

                            <div class="form-text">
                                Ürünün bağlı olduğu kurum değiştirildiğinde
                                sonraki borç aktarımları yeni kurum üzerinden
                                değerlendirilir.
                            </div>
                        </div>

                    </div>

                    <div class="urun-uyari-kutusu mb-4">

                        <div class="urun-uyari-simgesi">
                            i
                        </div>

                        <div>
                            <strong>Bilgilendirme</strong>

                            <div class="small text-muted mt-1">
                                Ürün kodu değiştirilse bile mevcut borç ve
                                tahsilat kayıtları silinmez.
                            </div>
                        </div>

                    </div>

                    <div class="d-flex flex-wrap gap-2">

                        <button type="submit"
                                class="btn btn-primary">
                            Değişiklikleri Kaydet
                        </button>

                        <a asp-action="Details"
                           asp-route-id="@Model.Id"
                           class="btn btn-outline-dark">
                            Ürün Detayı
                        </a>

                        <a asp-action="Index"
                           class="btn btn-secondary">
                            Listeye Dön
                        </a>

                    </div>

                </form>
            </div>
        </div>

    </div>
</div>

<style>
    .urun-id-etiketi {
        padding: 8px 13px;
        border: 1px solid #dce4ee;
        border-radius: 8px;
        background-color: white;
        color: #117b68;
        font-size: 13px;
        font-weight: 700;
    }

    .urun-duzenle-simgesi {
        width: 46px;
        height: 46px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 12px;
        background-color: #e6f5f1;
        color: #117b68;
        font-size: 18px;
        font-weight: 800;
    }

    .urun-uyari-kutusu {
        display: flex;
        align-items: flex-start;
        gap: 13px;
        padding: 16px 18px;
        border: 1px solid #cfe8df;
        border-left: 4px solid #15967d;
        border-radius: 10px;
        background-color: #f4fbf9;
    }

    .urun-uyari-simgesi {
        width: 31px;
        height: 31px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 50%;
        background-color: #15967d;
        color: white;
        font-weight: 800;
    }

    .form-text {
        margin-top: 6px;
        color: #667085;
        font-size: 12px;
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}