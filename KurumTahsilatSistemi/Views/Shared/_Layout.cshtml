            .kt-login-link:hover {
                color: #ffffff;
                background: rgba(255, 255, 255, 0.1);
            }

        @@media (max-width: 1199px) {
            .kt-main-content {
                padding: 28px 22px;
            }
        }

        @@media (max-width: 991.98px) {
            :root {
                --kt-topbar-height: 70px;
            }

            .kt-topbar {
                height: 70px;
                padding: 0 17px;
            }

            .kt-brand {
                min-width: auto;
            }

            .kt-brand-logo {
                width: 46px;
                height: 46px;
            }

            .kt-brand-text strong {
                font-size: 16px;
            }

            .kt-brand-text small {
                font-size: 9px;
            }

            .kt-topbar-left {
                gap: 15px;
            }

            .kt-sidebar-toggle {
                width: 37px;
                height: 37px;
                border-left: 0;
            }

            .kt-sidebar {
                width: min(280px, 84vw);
                transform: translateX(-105%);
                box-shadow: 12px 0 30px rgba(4, 35, 65, 0.16);
            }

            .kt-main,
            body.kt-sidebar-collapsed .kt-main {
                margin-left: 0;
            }

            body.kt-sidebar-mobile-open .kt-sidebar {
                transform: translateX(0);
            }

            body.kt-sidebar-mobile-open .kt-sidebar-overlay {
                display: block;
            }

            body.kt-sidebar-collapsed .kt-sidebar {
                width: min(280px, 84vw);
            }

            body.kt-sidebar-collapsed .kt-menu-section {
                display: block;
            }

            body.kt-sidebar-collapsed .kt-nav-label,
            body.kt-sidebar-collapsed .kt-nav-arrow,
            body.kt-sidebar-collapsed .kt-collapse-label {
                display: block;
            }

            body.kt-sidebar-collapsed .kt-nav-link {
                justify-content: flex-start;
                padding-right: 13px;
                padding-left: 13px;
            }

            .kt-sidebar-footer {
                display: none;
            }
        }

        @@media (max-width: 576px) {
            .kt-brand-text {
                display: none;
            }

            .kt-topbar-actions {
                gap: 7px;
            }

            .kt-account-button {
                padding-right: 9px;
                padding-left: 9px;
            }

            .kt-account-label {
                display: none;
            }

            .kt-main-content {
                padding: 22px 13px;
            }

            .kt-notification-link {
                width: 39px;
                height: 39px;
            }
        }

    </style>
</head>

