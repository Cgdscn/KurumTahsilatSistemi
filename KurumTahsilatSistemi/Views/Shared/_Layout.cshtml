@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using KurumTahsilatSistemi.Models
@using KurumTahsilatSistemi.Data

@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext DbContext

@{
    var controller =
        ViewContext.RouteData.Values["controller"]?.ToString();

    var action =
        ViewContext.RouteData.Values["action"]?.ToString();

    var girisYapildiMi =
        User.Identity?.IsAuthenticated == true;

    var adminMi =
        User.IsInRole("Admin");

    var kullaniciMi =
        User.IsInRole("Kullanici");

    var kullaniciAdi =
        User.Identity?.Name ?? "Kullanıcı";

    var kullaniciHarfi =
        string.IsNullOrWhiteSpace(kullaniciAdi)
            ? "K"
            : kullaniciAdi.Substring(0, 1).ToUpper();

    var okunmamisBildirimSayisi = 0;

    if (girisYapildiMi)
    {
        var oturumKullanicisi =
            await UserManager.GetUserAsync(User);

        if (oturumKullanicisi is not null)
        {
            okunmamisBildirimSayisi =
                await DbContext.Bildirimler
                    .AsNoTracking()
                    .CountAsync(x =>
                        x.ApplicationUserId ==
                            oturumKullanicisi.Id &&
                        !x.OkunduMu);
        }
    }
}

