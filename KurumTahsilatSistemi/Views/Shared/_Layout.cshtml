                id="aiFabButton"
                data-bs-toggle="offcanvas"
                data-bs-target="#aiAsistanPanel"
                aria-controls="aiAsistanPanel"
                aria-label="AI Asistanı Aç">

            <span class="ai-fab-status"></span>

            <svg viewBox="0 0 64 64"
                 xmlns="http://www.w3.org/2000/svg"
                 aria-hidden="true">

                <circle cx="32"
                        cy="32"
                        r="29"
                        fill="#ffffff" />

                <rect x="15"
                      y="22"
                      width="34"
                      height="27"
                      rx="11"
                      fill="#1677e8" />

                <circle cx="26"
                        cy="34"
                        r="3"
                        fill="#ffffff" />

                <circle cx="38"
                        cy="34"
                        r="3"
                        fill="#ffffff" />

                <path d="M25 42C29 45 35 45 39 42"
                      fill="none"
                      stroke="#ffffff"
                      stroke-width="2.5"
                      stroke-linecap="round" />

                <path d="M32 14V21"
                      stroke="#1677e8"
                      stroke-width="3"
                      stroke-linecap="round" />

                <circle cx="32"
                        cy="12"
                        r="4"
                        fill="#1677e8" />
            </svg>
        </button>

        <div class="offcanvas offcanvas-end ai-widget-panel"
             tabindex="-1"
             id="aiAsistanPanel"
             aria-labelledby="aiAsistanPanelBaslik">

            <div class="offcanvas-header ai-widget-header">

                <div class="d-flex align-items-center gap-3">

                    <div class="ai-widget-avatar">
                        AI
                    </div>

                    <div>
                        <h5 class="offcanvas-title mb-1"
                            id="aiAsistanPanelBaslik">
                            AI Tahsilat Asistanı
                        </h5>

                        <div class="ai-widget-status">
                            <span class="ai-widget-status-dot"></span>
                            Yerel AI asistan
                        </div>
                    </div>

                </div>

                <div class="d-flex align-items-center gap-2">

                    <button type="button"
