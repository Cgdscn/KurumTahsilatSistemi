                    </button>

                    <button type="button"
                            class="btn-close btn-close-white"
                            data-bs-dismiss="offcanvas"
                            aria-label="Kapat">
                    </button>

                </div>

            </div>

            <div class="offcanvas-body ai-widget-body">

                <div class="ai-widget-messages"
                     id="aiWidgetMesajlar">

                    <div class="ai-widget-welcome">

                        <div class="ai-widget-welcome-icon">
                            AI
                        </div>

                        <h6>Nasıl yardımcı olabilirim?</h6>

                        <p>
                            Borç sorgulama, ödeme, dekont ve sistem
                            kullanımı hakkında soru sorabilirsiniz.
                        </p>

                        <button type="button"
                                class="ai-widget-example"
                                data-ai-message="Borç sorgulama nasıl yapılır?">
                            Borç sorgulama nasıl yapılır?
                        </button>

                        <button type="button"
                                class="ai-widget-example"
                                data-ai-message="Dekontuma nereden ulaşabilirim?">
                            Dekontuma nereden ulaşabilirim?
                        </button>

                        <button type="button"
                                class="ai-widget-example"
                                data-ai-message="Tahsilatı kim iptal edebilir?">
                            Tahsilatı kim iptal edebilir?
                        </button>

                    </div>
                </div>

                <div class="ai-widget-input-area">

                    <!--
                        Formun normal şekilde gönderilmesi engelleniyor.
                        Mesaj yalnızca JavaScript fetch ile gönderilecek.
                    -->
                    <form id="aiWidgetForm"
                          onsubmit="return false;">

                        @Html.AntiForgeryToken()

                        <div class="ai-widget-input-group">

                            <textarea name="mesaj"
                                  id="aiWidgetInput"
                                  class="form-control"
                                  rows="2"
                                  maxlength="500"
                                  placeholder="Mesajınızı yazınız..."></textarea>

                            <button type="button"
                                    class="btn btn-primary"
                                    id="aiWidgetGonder">
                                Gönder
                            </button>

                        </div>

                        <small class="text-muted d-block mt-2">
                            Parola, kart numarası veya CVV paylaşmayınız.
                        </small>

                    </form>

                </div>

            </div>
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @if (girisYapildiMi)
    {
        <script>
            document.addEventListener(
                "DOMContentLoaded",
                function () {

                    const panel =
                        document.getElementById(
                            "aiAsistanPanel"
                        );

                    const aiFabButton =
                        document.getElementById(
                            "aiFabButton"
                        );

                    const mesajlarAlani =
                        document.getElementById(
                            "aiWidgetMesajlar"
                        );

                    const form =
                        document.getElementById(
                            "aiWidgetForm"
                        );

                    const input =
                        document.getElementById(
                            "aiWidgetInput"
                        );

                    const gonderButonu =
                        document.getElementById(
                            "aiWidgetGonder"
                        );

                    const temizleButonu =
                        document.getElementById(
                            "aiWidgetTemizle"
                        );

                    if (!panel ||
                        !aiFabButton ||
                        !mesajlarAlani ||
                        !form ||
                        !input ||
                        !gonderButonu ||
                        !temizleButonu) {

                        return;
                    }

                    const gecmisUrl =
                        '@Url.Action(
                                                                                                                                                                                                    "PopupGecmis",
                                                                                                                                                                                                    "AiAsistan")';

        const mesajUrl =
            '@Url.Action(
                                                                                                                                                                        "PopupMesaj",
                                                                                                                                                                        "AiAsistan")';

        const temizleUrl =
            '@Url.Action(
                                                                                                                                                                        "PopupTemizle",
                                                                                                                                                                        "AiAsistan")';

        function saatOlustur() {
            return new Date()
                .toLocaleTimeString(
                    "tr-TR",
                    {
                        hour: "2-digit",
                        minute: "2-digit"
                    }
                );
        }

                    function ornekSorulariBagla() {
                        mesajlarAlani
                            .querySelectorAll(
                                ".ai-widget-example"
                            )
                            .forEach(function (buton) {

                                buton.addEventListener(
                                    "click",
                                    function () {

                                        input.value =
                                            buton.dataset
                                                .aiMessage || "";

                                        input.focus();
                                    }
                                );
                            });
                    }

                    function welcomeGoster() {
                        mesajlarAlani.innerHTML = `
                            <div class="ai-widget-welcome">

                                <div class="ai-widget-welcome-icon">
                                    AI
                                </div>

                                <h6>
                                    Nasıl yardımcı olabilirim?
                                </h6>

                                <p>
                                    Borç sorgulama, ödeme, dekont ve
                                    sistem kullanımı hakkında soru
                                    sorabilirsiniz.
                                </p>

                                <button type="button"
                                        class="ai-widget-example"
                                        data-ai-message="Borç sorgulama nasıl yapılır?">
                                    Borç sorgulama nasıl yapılır?
                                </button>

                                <button type="button"
                                        class="ai-widget-example"
                                        data-ai-message="Dekontuma nereden ulaşabilirim?">
                                    Dekontuma nereden ulaşabilirim?
                                </button>

                                <button type="button"
                                        class="ai-widget-example"
                                        data-ai-message="Tahsilatı kim iptal edebilir?">
                                    Tahsilatı kim iptal edebilir?
                                </button>

                            </div>
                        `;

                        ornekSorulariBagla();
                    }

                    function mesajEkle(
                        rol,
                        icerik,
                        zaman) {

                        const satir =
                            document.createElement("div");

                        satir.className =
                            "ai-widget-row " +
                            (rol === "user"
                                ? "user"
                                : "assistant");

                        if (rol !== "user") {
                            const avatar =
                                document.createElement(
                                    "div"
                                );

                            avatar.className =
                                "ai-widget-mini-avatar";

                            avatar.textContent = "AI";

                            satir.appendChild(avatar);
                        }

                        const balon =
                            document.createElement("div");

                        balon.className =
                            "ai-widget-bubble";

                        const metin =
                            document.createElement("div");

                        metin.textContent =
                            icerik || "";

                        const saat =
                            document.createElement("div");

                        saat.className =
                            "ai-widget-time";

                        saat.textContent =
                            zaman || "";

                        balon.appendChild(metin);
                        balon.appendChild(saat);

                        satir.appendChild(balon);

                        mesajlarAlani.appendChild(
                            satir
                        );

                        mesajlarAlani.scrollTop =
                            mesajlarAlani.scrollHeight;

                        return satir;
                    }

                    async function gecmisiYukle() {
                        mesajlarAlani.innerHTML = `
                            <div class="text-center
                                        text-muted py-5">
                                Sohbet yükleniyor...
                            </div>
                        `;

                        try {
                            const response =
                                await fetch(
                                    gecmisUrl,
                                    {
                                        method: "GET",
                                        headers: {
                                            "X-Requested-With":
                                                "XMLHttpRequest"
                                        }
                                    }
                                );

                            if (!response.ok) {
                                throw new Error(
                                    "Geçmiş yüklenemedi."
                                );
                            }

                            const mesajlar =
                                await response.json();

                            mesajlarAlani.innerHTML = "";

                            if (!mesajlar.length) {
                                welcomeGoster();
                                return;
                            }

                            mesajlar.forEach(
                                function (mesaj) {
                                    mesajEkle(
                                        mesaj.rol,
                                        mesaj.icerik,
                                        mesaj.zaman
                                    );
                                }
                            );
                        }
                        catch (error) {
                            mesajlarAlani.innerHTML = "";

                            mesajEkle(
                                "assistant",
                                "Sohbet geçmişi yüklenemedi.",
                                ""
                            );

                            console.error(error);
                        }
                    }

                    async function mesajGonder() {
                        const mesaj =
                            input.value.trim();

                        if (!mesaj ||
                            gonderButonu.disabled) {

                            input.focus();
                            return;
                        }

                        const welcome =
                            mesajlarAlani.querySelector(
                                ".ai-widget-welcome"
                            );

                        if (welcome) {
                            welcome.remove();
                        }

                        mesajEkle(
                            "user",
                            mesaj,
                            saatOlustur()
                        );

                        input.value = "";

                        gonderButonu.disabled = true;
                        gonderButonu.textContent = "...";

                        const beklemeSatiri =
                            mesajEkle(
                                "assistant",
                                "Yanıt hazırlanıyor...",
                                ""
                            );

                        try {
                            const formData =
                                new FormData(form);

                            formData.set(
                                "mesaj",
                                mesaj
                            );

                            const response =
                                await fetch(
                                    mesajUrl,
                                    {
                                        method: "POST",
                                        body: formData,
                                        headers: {
                                            "X-Requested-With":
                                                "XMLHttpRequest"
                                        }
                                    }
                                );

                            const contentType =
                                response.headers.get(
                                    "content-type"
                                ) || "";

                            if (!contentType.includes(
                                "application/json")) {

                                throw new Error(
                                    "Sunucudan JSON yanıtı alınamadı."
                                );
                            }

                            const sonuc =
                                await response.json();

                            beklemeSatiri.remove();

                            if (!response.ok) {
                                mesajEkle(
                                    "assistant",
                                    sonuc.hata ||
                                    "Mesaj gönderilemedi.",
                                    ""
                                );

                                return;
                            }

                            mesajEkle(
                                "assistant",
                                sonuc.cevap,
                                sonuc.zaman
                            );
                        }
                        catch (error) {
                            beklemeSatiri.remove();

                            mesajEkle(
                                "assistant",
                                "AI servisine ulaşılamadı. " +
                                "Ollama uygulamasının açık " +
                                "olduğunu kontrol ediniz.",
                                ""
                            );

                            console.error(error);
                        }
                        finally {
                            gonderButonu.disabled = false;
                            gonderButonu.textContent =
                                "Gönder";

                            input.focus();
                        }
                    }

                    panel.addEventListener(
                        "show.bs.offcanvas",
                        function () {
                            aiFabButton.classList.add(
                                "ai-fab-gizli"
                            );
                        }
                    );

                    panel.addEventListener(
                        "shown.bs.offcanvas",
                        function () {
                            gecmisiYukle();
                            input.focus();
                        }
                    );

                    panel.addEventListener(
                        "hidden.bs.offcanvas",
                        function () {
                            aiFabButton.classList.remove(
                                "ai-fab-gizli"
                            );
                        }
                    );

                    gonderButonu.addEventListener(
                        "click",
                        function (event) {
                            event.preventDefault();
                            event.stopPropagation();

                            mesajGonder();
                        }
                    );

                    input.addEventListener(
                        "keydown",
                        function (event) {

                            if (event.key === "Enter" &&
                                !event.shiftKey) {

                                event.preventDefault();
                                event.stopPropagation();

                                mesajGonder();
                            }
                        }
                    );

                    temizleButonu.addEventListener(
                        "click",
                        async function (event) {

                            event.preventDefault();
                            event.stopPropagation();

                            if (!confirm(
                                "Sohbet geçmişi temizlensin mi?")) {

                                return;
                            }

                            try {
                                const formData =
                                    new FormData(form);

                                const response =
                                    await fetch(
                                        temizleUrl,
                                        {
                                            method: "POST",
                                            body: formData,
                                            headers: {
                                                "X-Requested-With":
                                                    "XMLHttpRequest"
                                            }
                                        }
                                    );

                                if (!response.ok) {
                                    throw new Error(
                                        "Sohbet temizlenemedi."
                                    );
                                }

                                welcomeGoster();
                            }
                            catch (error) {
                                alert(
                                    "Sohbet geçmişi temizlenemedi."
                                );

                                console.error(error);
                            }
                        }
                    );

                    ornekSorulariBagla();
                }
            );
        </script>
        }


    @if (girisYapildiMi)
    {
        <script>
            document.addEventListener(
                "DOMContentLoaded",
                function () {

                    const body =
                        document.body;

                    const topToggle =
                        document.getElementById(
                            "ktSidebarToggle");

                    const bottomToggle =
                        document.getElementById(
                            "ktSidebarCollapse");

                    const overlay =
                        document.getElementById(
                            "ktSidebarOverlay");

                    const mobileMedia =
                        window.matchMedia(
                            "(max-width: 991.98px)");

                    function masaustuDurumunuYukle() {
                        if (mobileMedia.matches) {
                            body.classList.remove(
                                "kt-sidebar-collapsed");

                            return;
                        }

                        const daraltildiMi =
                            localStorage.getItem(
                                "ktSidebarCollapsed")
                            === "true";

                        body.classList.toggle(
                            "kt-sidebar-collapsed",
                            daraltildiMi);
                    }

                    function menuDurumunuDegistir() {
                        if (mobileMedia.matches) {
                            body.classList.toggle(
                                "kt-sidebar-mobile-open");

                            return;
                        }

                        body.classList.toggle(
                            "kt-sidebar-collapsed");

                        localStorage.setItem(
                            "ktSidebarCollapsed",
                            body.classList.contains(
                                "kt-sidebar-collapsed")
                                ? "true"
                                : "false");
                    }

                    function mobilMenuyuKapat() {
                        body.classList.remove(
                            "kt-sidebar-mobile-open");
                    }

                    if (topToggle) {
                        topToggle.addEventListener(
                            "click",
                            menuDurumunuDegistir);
                    }

                    if (bottomToggle) {
                        bottomToggle.addEventListener(
                            "click",
                            menuDurumunuDegistir);
                    }

                    if (overlay) {
                        overlay.addEventListener(
                            "click",
                            mobilMenuyuKapat);
                    }

                    document
                        .querySelectorAll(
                            ".kt-sidebar .kt-nav-link")
                        .forEach(function (link) {

                            link.addEventListener(
                                "click",
                                function () {

                                    if (mobileMedia.matches) {
                                        mobilMenuyuKapat();
                                    }
                                });
                        });

                    window.addEventListener(
                        "resize",
                        function () {

                            if (!mobileMedia.matches) {
                                body.classList.remove(
                                    "kt-sidebar-mobile-open");
                            }

                            masaustuDurumunuYukle();
                        });

                    masaustuDurumunuYukle();
                });
        </script>
    }

    @await RenderSectionAsync(
    "Scripts",
        required: false)

</body>
</html>