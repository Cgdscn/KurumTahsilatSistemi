@model IEnumerable<KurumTahsilatSistemi.Models.Bildirim>

@{
    ViewData["Title"] = "Bildirimler";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <h2>
        <i class="bi bi-bell-fill text-warning"></i>
        Bildirimler
    </h2>

    @if (Model.Any(x => !x.OkunduMu))
    {
        <form asp-action="TumunuOkunduIsaretle"
              method="post">

            @Html.AntiForgeryToken()

            <button class="btn btn-success">

                <i class="bi bi-check2-all"></i>

                Tümünü Okundu Yap

            </button>

        </form>
    }

</div>

@if (!Model.Any())
{
    <div class="alert alert-info">

        Henüz bildiriminiz bulunmuyor.

    </div>
}
else
{
    foreach (var bildirim in Model)
    {
        <div class="card mb-3 shadow-sm
                    @(bildirim.OkunduMu ? "" : "border-primary")">

            <div class="card-body">

                <div class="d-flex justify-content-between">

                    <div>

                        @switch (bildirim.BildirimTipi)
                        {
                            case "Başarılı":

                                <span class="badge bg-success">
                                    Başarılı
                                </span>

                                break;

                            case "Uyarı":

                                <span class="badge bg-warning text-dark">
                                    Uyarı
                                </span>

                                break;

                            case "Hata":

                                <span class="badge bg-danger">
                                    Hata
                                </span>

                                break;

                            default:

                                <span class="badge bg-primary">
                                    Bilgi
                                </span>

                                break;
                        }

                        @if (!bildirim.OkunduMu)
                        {
                            <span class="badge bg-danger ms-2">

                                Yeni

                            </span>
                        }

                    </div>

                    <small class="text-muted">

                        @bildirim.OlusturmaTarihi.ToString("dd.MM.yyyy HH:mm")

                    </small>

                </div>

                <h5 class="mt-3">

                    @bildirim.Baslik

                </h5>

                <p>

                    @bildirim.Mesaj

                </p>

                @if (!bildirim.OkunduMu)
                {
                    <form asp-action="OkunduIsaretle"
                          asp-route-id="@bildirim.Id"
                          method="post">

                        @Html.AntiForgeryToken()

                        <button class="btn btn-outline-primary btn-sm">

                            Okundu Olarak İşaretle

                        </button>

                    </form>
                }
                else
                {
                    <small class="text-success">

                        ✔ Okundu

                    </small>
                }

            </div>

        </div>
    }
}