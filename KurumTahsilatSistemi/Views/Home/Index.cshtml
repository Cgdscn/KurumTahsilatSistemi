</style>

@section Scripts
{
    @if (adminMi)
    {
        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

        <script>
            const sonYediGunEtiketleri =
                @Html.Raw(
                    JsonSerializer.Serialize(
                            Model.SonYediGunEtiketleri));

    const sonYediGunTahsilatlari =
        @Html.Raw(
                        JsonSerializer.Serialize(
                                Model.SonYediGunTahsilatlari));

    const borcDurumEtiketleri =
        @Html.Raw(
                        JsonSerializer.Serialize(
                                Model.BorcDurumEtiketleri));

    const borcDurumSayilari =
        @Html.Raw(
                        JsonSerializer.Serialize(
                                Model.BorcDurumSayilari));

    const paraFormati =
        new Intl.NumberFormat(
            "tr-TR",
            {
                style: "currency",
                currency: "TRY",
                maximumFractionDigits: 0
            });

    const sonYediGunCanvas =
        document.getElementById(
            "sonYediGunGrafigi");

    if (sonYediGunCanvas) {
        new Chart(
            sonYediGunCanvas,
            {
                type: "bar",

                data: {
                    labels:
                        sonYediGunEtiketleri,

                    datasets: [
                        {
                            data:
                                sonYediGunTahsilatlari,

                            backgroundColor:
                                "#2478e7",

                            hoverBackgroundColor:
                                "#155fbf",

                            borderRadius:
                                3,

                            borderSkipped:
                                false,

                            barPercentage:
                                0.54,

                            categoryPercentage:
                                0.8
                        }
                    ]
                },

                options: {
                    responsive: true,
                    maintainAspectRatio: false,

                    plugins: {
                        legend: {
                            display: false
                        },

                        tooltip: {
                            callbacks: {
                                label:
                                    function (context) {
                                        return paraFormati
                                            .format(
                                                context.raw);
                                    }
                            }
                        }
                    },

                    scales: {
                        x: {
                            grid: {
                                display: false
                            },

                            border: {
                                display: false
                            },

                            ticks: {
                                color: "#7e8ca0",
                                font: {
                                    size: 10
                                }
                            }
                        },

                        y: {
                            beginAtZero: true,

                            border: {
                                display: false
                            },

                            grid: {
                                color:
                                    "rgba(125, 145, 170, 0.14)"
                            },

                            ticks: {
                                color: "#7e8ca0",

                                font: {
                                    size: 9
                                },

                                callback:
                                    function (value) {
                                        if (value >= 1000) {
                                            return (
                                                value / 1000
                                            ) + "K";
                                        }

                                        return value;
                                    }
                            }
                        }
                    }
                }
            });
    }

    const borcDurumCanvas =
        document.getElementById(
            "borcDurumGrafigi");

    if (borcDurumCanvas) {
        new Chart(
            borcDurumCanvas,
            {
                type: "doughnut",

                data: {
                    labels:
                        borcDurumEtiketleri,

                    datasets: [
                        {
                            data:
                                borcDurumSayilari,

                               backgroundColor: [
                                    "#f45b5b", // Ödenmedi - kırmızı
                                    "#f6b925", // Kısmi Ödendi - sarı
                                    "#35b889", // Ödendi - yeşil
                                    "#8091a7"  // Tanımsız durum
                               ],

                            borderColor:
                                "#ffffff",

                            borderWidth:
                                2,

                            hoverOffset:
                                4
                        }
                    ]
                },

                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: "58%",

                    plugins: {
                        legend: {
                            display: false
                        },

                        tooltip: {
                            callbacks: {
                                label:
                                    function (context) {
                                        const values =
                                            context.dataset.data;

                                        const total =
                                            values.reduce(
                                                (a, b) =>
                                                    a + b,
                                                0);

                                        const percentage =
                                            total > 0
                                                ? Math.round(
                                                    context.raw *
                                                    100 /
                                                    total)
                                                : 0;

                                        return (
                                            context.label +
                                            ": " +
                                            context.raw +
                                            " (%" +
                                            percentage +
                                            ")"
                                        );
                                    }
                            }
                        }
                    }
                }
            });
    }
</script>
    }
}