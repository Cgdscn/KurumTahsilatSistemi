@model IEnumerable<KurumTahsilatSistemi.Models.AuditLogs>

@{
    ViewData["Title"] = "İşlem Logları";

    var kullanici =
        Context.Request.Query["kullanici"].ToString();

    var islemTipi =
        Context.Request.Query["islemTipi"].ToString();
}

<div class="d-flex flex-column flex-md-row
            justify-content-between align-items-md-center
            gap-3 mb-4">

    <div>
        <h2 class="mb-2">
            İşlem Logları
        </h2>

        <p class="text-muted mb-0">
            Sistemde gerçekleştirilen kritik işlemler,
            kullanıcı ve işlem bilgileriyle birlikte
            görüntülenmektedir.
        </p>
    </div>

    <a asp-controller="Home"
       asp-action="Index"
       class="btn btn-secondary">
        Ana Sayfaya Dön
    </a>
</div>

<div class="card mb-4">
    <div class="card-header">
        Log Filtreleme
    </div>

    <div class="card-body">

        <form method="get"
              asp-controller="AuditLogs"
              asp-action="Index"
              class="row g-3">

            <div class="col-md-4">
                <label for="kullanici"
                       class="form-label">
                    Kullanıcı
                </label>

                <input type="text"
                       id="kullanici"
                       name="kullanici"
                       value="@kullanici"
                       class="form-control"
                       placeholder="Kullanıcı adı veya e-posta" />
            </div>

            <div class="col-md-4">
                <label for="islemTipi"
                       class="form-label">
                    İşlem Türü
                </label>

                <input type="text"
                       id="islemTipi"
                       name="islemTipi"
                       value="@islemTipi"
                       class="form-control"
                       placeholder="Örn: Müşteri Oluşturma" />
            </div>

            <div class="col-md-4 d-flex align-items-end gap-2">

                <button type="submit"
                        class="btn btn-primary flex-grow-1">
                    Filtrele
                </button>

                <a asp-controller="AuditLogs"
                   asp-action="Index"
                   class="btn btn-outline-secondary">
                    Temizle
                </a>

            </div>
        </form>

    </div>
</div>

<div class="card">
    <div class="card-header d-flex
                justify-content-between align-items-center">

        <span>
            İşlem Kayıtları
        </span>

        <span class="badge bg-primary">
            @Model.Count() kayıt
        </span>

    </div>

    <div class="card-body p-0">

        @if (!Model.Any())
        {
            <div class="p-5 text-center">

                <div class="text-muted mb-2">
                    Görüntülenecek işlem kaydı bulunamadı.
                </div>

                <small class="text-muted">
                    Sistemde loglanan işlemler bu ekranda
                    listelenecektir.
                </small>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover
                                  align-middle mb-0">

                    <thead>
                        <tr>
                            <th>Tarih</th>
                            <th>Kullanıcı</th>
                            <th>İşlem</th>
                            <th>Açıklama</th>
                            <th>Kaynak</th>
                            <th>IP Adresi</th>
                            <th>Durum</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            var durumSinifi =
                            item.Durum switch
                            {
                                "Başarılı" =>
                                            "bg-success",

                                "Uyarı" =>
                                            "bg-warning text-dark",

                                _ =>
                                            "bg-danger"
                            };

                            <tr>
                                <td class="text-nowrap">
                                    @(item.IslemTarihi
                                                                .ToString("dd.MM.yyyy HH:mm:ss"))
                        </td>

                                <td>
                                    <div class="fw-semibold">
                                        @item.Kullanici
                                    </div>
                                </td>

                                <td>
                                    @item.IslemTipi
                                </td>

                                <td class="audit-aciklama">
                                    @item.Aciklama
                                </td>

                                <td>
                            @if (!string.IsNullOrWhiteSpace(
                                                        item.Controller))
                                    {
                                        <div class="small fw-semibold">
                                            @item.Controller
                                        </div>

                                        <div class="small text-muted">
                                            @item.Action
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            -
                                        </span>
                                    }
                            </td>

                            <td class="text-nowrap">
                                @(string.IsNullOrWhiteSpace(
                                                            item.IPAdresi)
                                                            ? "-"
                                                            : item.IPAdresi)
                        </td>

                                <td>
                                    <span class="badge @durumSinifi">
                                        @item.Durum
                                    </span>
                                </td>
                            </tr>
                                        }

                    </tbody>
                </table>

            </div>
        }

    </div>
</div>

<style>
    .audit-aciklama {
        min-width: 260px;
        max-width: 420px;
        white-space: normal;
        overflow-wrap: anywhere;
    }

    table thead th {
        white-space: nowrap;
    }
</style>