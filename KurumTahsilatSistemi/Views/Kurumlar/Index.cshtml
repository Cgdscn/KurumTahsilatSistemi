@model IEnumerable<KurumTahsilatSistemi.Models.Kurum>

@{
    ViewData["Title"] = "Kurum Yönetimi";
}

<div class="d-flex flex-column flex-md-row
            justify-content-between align-items-md-center
            gap-3 mb-4">

    <div>
        <h2 class="mb-2">Kurum Yönetimi</h2>

        <p class="text-muted mb-0">
            Sistemde işlem yapılacak kurumları görüntüleyebilir,
            yeni kurum ekleyebilir ve mevcut kurumları düzenleyebilirsiniz.
        </p>
    </div>

    <div>
        <a asp-action="Create"
           class="btn btn-primary">
            Yeni Kurum Ekle
        </a>
    </div>
</div>

@if (TempData["BasariMesaji"] != null)
{
    <div class="alert alert-success">
        @TempData["BasariMesaji"]
    </div>
}

@if (TempData["HataMesaji"] != null)
{
    <div class="alert alert-danger">
        @TempData["HataMesaji"]
    </div>
}

@if (!Model.Any())
{
    <div class="card">
        <div class="card-body text-center py-5">

            <div class="empty-icon mb-3">
                K
            </div>

            <h4>Henüz kurum eklenmemiş</h4>

            <p class="text-muted">
                Tahsilat ürünlerini ve borç kayıtlarını oluşturabilmek
                için önce bir kurum eklenmelidir.
            </p>

            <a asp-action="Create"
               class="btn btn-primary">
                İlk Kurumu Ekle
            </a>
        </div>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle kurum-table">
            <thead>
                <tr>
                    <th>Kurum Bilgisi</th>
                    <th>Kurum Kodu</th>
                    <th>Hesap Numarası</th>
                    <th>Durum</th>
                    <th class="text-center">İşlemler</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var kurum in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-3">

                                <div class="kurum-avatar">
                                    @{
                                        var kurumHarfi =
                                        string.IsNullOrWhiteSpace(kurum.KurumAdi)
                                        ? "K"
                                        : kurum.KurumAdi.Substring(0, 1).ToUpper();
                                    }

                                    @kurumHarfi
                                </div>

                                <div>
                                    <div class="fw-semibold">
                                        @kurum.KurumAdi
                                    </div>

                                    <div class="small text-muted">
                                        Kurum No: @kurum.Id
                                    </div>
                                </div>

                            </div>
                        </td>

                        <td>
                            <span class="kurum-kodu">
                                @kurum.KurumKodu
                            </span>
                        </td>

                        <td>
                            @if (string.IsNullOrWhiteSpace(kurum.HesapNo))
                            {
                                <span class="text-muted">
                                    Tanımlanmamış
                                </span>
                            }
                            else
                            {
                                <span>@kurum.HesapNo</span>
                            }
                        </td>

                        <td>
                            @if (kurum.AktifMi)
                            {
                                <span class="badge bg-success">
                                    Aktif
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    Pasif
                                </span>
                            }
                        </td>

                        <td>
                            <div class="d-flex flex-wrap
                                                justify-content-center gap-2">

                                <a asp-action="Details"
                                   asp-route-id="@kurum.Id"
                                   class="btn btn-outline-primary btn-sm">
                                    Detay
                                </a>

                                <a asp-action="Edit"
                                   asp-route-id="@kurum.Id"
                                   class="btn btn-primary btn-sm">
                                    Düzenle
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@kurum.Id"
                                   class="btn btn-danger btn-sm">
                                    Sil
                                </a>

                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<style>
    .kurum-table {
        width: 100%;
        table-layout: fixed;
    }

        .kurum-table th:nth-child(1) {
            width: 27%;
        }

        .kurum-table th:nth-child(2) {
            width: 16%;
        }

        .kurum-table th:nth-child(3) {
            width: 22%;
        }

        .kurum-table th:nth-child(4) {
            width: 12%;
        }

        .kurum-table th:nth-child(5) {
            width: 23%;
        }

    .kurum-avatar {
        width: 44px;
        height: 44px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 12px;
        background-color: #e7f0fa;
        color: #123b6d;
        font-size: 17px;
        font-weight: 800;
    }

    .kurum-kodu {
        display: inline-block;
        padding: 6px 10px;
        border: 1px solid #dce4ee;
        border-radius: 7px;
        background-color: #f8fafc;
        color: #344054;
        font-size: 13px;
        font-weight: 600;
    }

    .empty-icon {
        width: 65px;
        height: 65px;
        margin-right: auto;
        margin-left: auto;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 18px;
        background-color: #e7f0fa;
        color: #123b6d;
        font-size: 25px;
        font-weight: 800;
    }

    @@media (max-width: 768px) {
        .kurum-table {
            min-width: 800px;
            table-layout: auto;
        }
    }
</style>