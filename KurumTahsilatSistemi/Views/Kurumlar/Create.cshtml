@model KurumTahsilatSistemi.Models.Kurum

@{
    ViewData["Title"] = "Yeni Kurum Ekle";
}

<div class="row justify-content-center">
    <div class="col-lg-8">

        <div class="mb-4">
            <h2 class="mb-2">Yeni Kurum Ekle</h2>

            <p class="text-muted mb-0">
                Tahsilat işlemlerinde kullanılacak kurumun temel
                bilgilerini giriniz.
            </p>
        </div>

        <div class="card">

            <div class="card-header d-flex align-items-center gap-3">
                <div class="form-header-icon">
                    K
                </div>

                <div>
                    <div>Kurum Bilgileri</div>

                    <small class="text-muted fw-normal">
                        Zorunlu alanları eksiksiz doldurunuz.
                    </small>
                </div>
            </div>

            <div class="card-body">

                <form asp-action="Create" method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger">
                    </div>

                    <div class="row">

                        <div class="col-md-6 mb-3">
                            <label asp-for="KurumKodu"
                                   class="form-label">
                            </label>

                            <input asp-for="KurumKodu"
                                   class="form-control"
                                   placeholder="Örnek: UNI001" />

                            <span asp-validation-for="KurumKodu"
                                  class="text-danger">
                            </span>

                            <div class="form-text">
                                Kurumu benzersiz olarak tanımlayan kısa kod.
                            </div>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="KurumAdi"
                                   class="form-label">
                            </label>

                            <input asp-for="KurumAdi"
                                   class="form-control"
                                   placeholder="Örnek: Biruni Üniversitesi" />

                            <span asp-validation-for="KurumAdi"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="col-12 mb-3">
                            <label asp-for="HesapNo"
                                   class="form-label">
                            </label>

                            <input asp-for="HesapNo"
                                   class="form-control"
                                   placeholder="Kurum tahsilat hesabını giriniz" />

                            <span asp-validation-for="HesapNo"
                                  class="text-danger">
                            </span>

                            <div class="form-text">
                                Gerçek banka hesabı kullanılmıyorsa test amaçlı
                                bir hesap numarası girilebilir.
                            </div>
                        </div>

                        <div class="col-12 mb-4">
                            <div class="status-box">
                                <div>
                                    <label asp-for="AktifMi"
                                           class="form-label mb-1">
                                        Kurum Durumu
                                    </label>

                                    <div class="small text-muted">
                                        Aktif kurumlar borç dosyası ve tahsilat
                                        işlemlerinde seçilebilir.
                                    </div>
                                </div>

                                <div class="form-check form-switch">
                                    <input asp-for="AktifMi"
                                           class="form-check-input"
                                           role="switch" />

                                    <label asp-for="AktifMi"
                                           class="form-check-label">
                                        Aktif
                                    </label>
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="d-flex flex-wrap gap-2">
                        <button type="submit"
                                class="btn btn-primary">
                            Kurumu Kaydet
                        </button>

                        <a asp-action="Index"
                           class="btn btn-secondary">
                            Listeye Dön
                        </a>
                    </div>

                </form>
            </div>
        </div>

    </div>
</div>

<style>
    .form-header-icon {
        width: 44px;
        height: 44px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 12px;
        background-color: #e7f0fa;
        color: #123b6d;
        font-size: 18px;
        font-weight: 800;
    }

    .status-box {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding: 17px 18px;
        border: 1px solid #dce4ee;
        border-radius: 11px;
        background-color: #f8fafc;
    }

        .status-box .form-check-input {
            width: 46px;
            height: 23px;
            cursor: pointer;
        }

            .status-box .form-check-input:checked {
                border-color: #15967d;
                background-color: #15967d;
            }

    .form-text {
        margin-top: 6px;
        color: #667085;
        font-size: 12px;
    }

    @@media (max-width: 576px) {
        .status-box {
            align-items: flex-start;
            flex-direction: column;
        }
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}